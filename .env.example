# =============================================================================
# Ogum Security — Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# --- ArangoDB ---
ARANGO_HOST=localhost
ARANGO_PORT=8529
ARANGO_DB=ogum_security
ARANGO_USER=root
ARANGO_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Redpanda / Kafka ---
REDPANDA_BROKERS=localhost:9092

# --- Ogum.AI (LLM) ---
# For local Ollama (default):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:instruct
# For Amazon Bedrock (enterprise, optional):
# AWS_BEDROCK_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# --- Vector DB (RAG) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Auth (OIDC) ---
OIDC_ISSUER_URL=https://your-idp.example.com
OIDC_CLIENT_ID=ogum-security
OIDC_CLIENT_SECRET=your-oidc-client-secret
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./certs/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./certs/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS (for Ogum.Static + Ogum.Dynamic) ---
# Use IAM Role federation (IRSA) in production. Keys only for local dev.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Azure (for Ogum.Static) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# --- GCP (for Ogum.Static) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=

# --- GitHub (for Ogum.AI GitOps) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./certs/github_app.pem
# GITHUB_APP_INSTALLATION_ID=

# --- Integrations ---
# Jira
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_USER_EMAIL=security-bot@yourorg.com
# JIRA_API_TOKEN=

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DEFAULT_CHANNEL=#security-alerts

# Microsoft Teams
# TEAMS_WEBHOOK_URL=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Splunk
# SPLUNK_HEC_URL=https://splunk.yourorg.com:8088
# SPLUNK_HEC_TOKEN=

# AWS Security Hub
# SECURITY_HUB_REGION=us-east-1
# SECURITY_HUB_ACCOUNT_ID=

# --- HashiCorp Vault (production secrets) ---
# VAULT_ADDR=https://vault.yourorg.com
# VAULT_TOKEN=
# VAULT_MOUNT_PATH=secret/ogum-security

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
